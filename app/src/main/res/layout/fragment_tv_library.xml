<?xml version="1.0" encoding="utf-8"?>
<!-- TV home screen: every video and audio file on the device, as a grid of thumbnails. No buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aengus_paper"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp">

    <TextView
        android:id="@+id/heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_library_title"
        android:textColor="@color/aengus_ink"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/tv_library_hint"
        android:textColor="@color/aengus_ink_soft"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/aengus_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="96dp"
            android:padding="24dp"
            android:textColor="@color/aengus_ink"
            android:textSize="22sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
