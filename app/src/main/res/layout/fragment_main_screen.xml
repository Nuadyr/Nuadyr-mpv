<?xml version="1.0" encoding="utf-8"?>
<!-- Phone/tablet home screen. Same ids and view types as layout-television/fragment_main_screen.xml, so view binding keeps working. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="2"
        android:contentDescription="@string/mpv_activity"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/mpv_logo" />

    <!-- Top row: the two ways to start something new. Filled = primary. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/docBtn"
            style="@style/Widget.Aengus.Button.Tile.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="@string/action_open_doc_tree"
            app:icon="@drawable/ic_file_open_48dp"
            app:iconTint="?attr/colorOnPrimary" />

        <Button
            android:id="@+id/urlBtn"
            style="@style/Widget.Aengus.Button.Tile.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="@string/action_open_url"
            app:icon="@drawable/ic_link_48dp"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

    <!-- Bottom row: secondary. Tonal = quieter. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <Button
            android:id="@+id/filepickerBtn"
            style="@style/Widget.Aengus.Button.Tile.Tonal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="@string/file_picker_old"
            app:icon="@drawable/ic_folder_white_48dp"
            app:iconTint="?attr/colorOnSecondaryContainer" />

        <Button
            android:id="@+id/settingsBtn"
            style="@style/Widget.Aengus.Button.Tile.Tonal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="@string/action_settings"
            app:icon="@drawable/ic_settings_black_48dp"
            app:iconTint="?attr/colorOnSecondaryContainer" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/option_remember_choice"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            app:showText="false" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
