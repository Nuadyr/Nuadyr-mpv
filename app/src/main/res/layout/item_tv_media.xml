<?xml version="1.0" encoding="utf-8"?>
<!-- One tile in the TV library grid. The thumbnail is decorative: the title and kind below name the item. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/aengus_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp"
    android:stateListAnimator="@animator/aengus_focus_scale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@color/aengus_tonal"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/aengus_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aengus_ink_soft"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
