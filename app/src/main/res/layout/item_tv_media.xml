<?xml version="1.0" encoding="utf-8"?>
<!-- One tile in the TV library grid. The thumbnail is decorative: the title and kind below name the item.
     The progress bar, when shown, says how much has been watched. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/aengus_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp"
    android:stateListAnimator="@animator/aengus_focus_scale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/aengus_tonal"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <!-- How many files a group card holds. Hidden on a single file. -->
            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/aengus_badge_bg"
                android:importantForAccessibility="no"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textColor="@color/aengus_paper"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Where playback stopped. Shown only for files that were started and not finished. -->
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="yes"
                android:max="100"
                android:progressDrawable="@drawable/aengus_tile_progress"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/aengus_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aengus_ink_soft"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
