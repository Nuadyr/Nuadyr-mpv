<?xml version="1.0" encoding="utf-8"?>
<!-- Selected-segment / pressed fill: a rounded tonal chip. Colours follow the Aengus day/night palette. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aengus_outline_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aengus_outline_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aengus_tonal" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
